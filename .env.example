# Application
APP_NAME=EVE Healthcare
APP_VERSION=0.1.0
DEBUG=true

# Database (use postgresql+psycopg2:// to explicitly select the psycopg2 driver)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/eve_healthcare

# JWT (change in production)
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Webhook (change in production)
WEBHOOK_SECRET=dev-webhook-secret-change-in-production

# Rate Limiting
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_AUTH=5/minute
